#!/system/bin/sh
. /data/local/tmp/ancli/bin/ancli_env.sh 2>/dev/null || true
# Default working directory configured with `ancli config --set default_cwd=...`
# (also editable in the WebUI). Empty = built-in /root.
_ancli_default_cwd=""
_ancli_cfg=/data/local/tmp/ancli/rootfs/root/.ancli-config.json
if [ -f "$_ancli_cfg" ]; then
    _ancli_default_cwd=$(sed -n 's/^[[:space:]]*"default_cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_ancli_cfg" 2>/dev/null | head -n 1)
fi
case "$_ancli_default_cwd" in
    "") ;;
    /dev*|/proc*|/sys*|/sdcard*|/storage*|/mnt*|/data*|/apex*|/system*|/linkerconfig*) ;;
    *) [ -d "/data/local/tmp/ancli/rootfs$_ancli_default_cwd" ] || _ancli_default_cwd="" ;;
esac
# Resolve PRoot working directory: fall back to the container HOME when PWD
# is not visible inside the rootfs (e.g. an unbound host path like /cache).
PROOT_CWD="$PWD"
case "$PROOT_CWD" in
    /|/dev*|/proc*|/sys*|/sdcard*|/storage*|/mnt*|/data*|/apex*|/system*|/linkerconfig*)
        ;;
    *)
        if [ ! -d "/data/local/tmp/ancli/rootfs$PROOT_CWD" ]; then
            PROOT_CWD=/root
        fi
        ;;
esac
# 2026-11-13: Redirect only the working directory; keep the launcher silent so
# status and task logs contain command output rather than framework hints.
if [ "$PROOT_CWD" = "/" ]; then
    if [ -n "$_ancli_default_cwd" ]; then
        PROOT_CWD="$_ancli_default_cwd"
    else
        PROOT_CWD=/root
    fi
fi
: "${PROOT_CWD:=/root}"
# 2026-11-13: reset must stop existing Agent processes before deleting their
# files. A root shell can outlive the Termius tab that launched it, so perform
# this preflight on the Android side, before entering PRoot.
if [ "${1:-}" = "reset" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    _ancli_agent_re='(/data/adb/(ksu|ap)/bin|/usr/local/bin)/(aider|mimo|agy|dsh|claude|opencode|grok)'
    /system/bin/toybox pkill -TERM -f "$_ancli_agent_re" 2>/dev/null || true
    /system/bin/toybox pkill -TERM -f "proot.*\/data\/local\/tmp\/ancli\/rootfs" 2>/dev/null || true
    /system/bin/sleep 1
    /system/bin/toybox pkill -KILL -f "$_ancli_agent_re" 2>/dev/null || true
    /system/bin/toybox pkill -KILL -f "proot.*\/data\/local\/tmp\/ancli\/rootfs" 2>/dev/null || true
fi
# Provide /dev/shm: Android's /dev has no shm, and Node/Bun workers plus some
# libraries require shared memory. Bound only when the dir is usable.
SHM_BIND=""
if mkdir -p /data/local/tmp/ancli/shm 2>/dev/null; then
    # 1777 (sticky, /tmp-style) so the shell user (uid 2000) can write inside
    chmod 1777 /data/local/tmp/ancli/shm 2>/dev/null || true
    SHM_BIND="-b /data/local/tmp/ancli/shm:/dev/shm"
fi
# Some adb-root namespaces omit the /sdcard alias. Keep every available
# Android tree mapped and skip only an absent alias to avoid a noisy proot
# warning during the launcher itself.
ANCLI_BIND_ARGS=""
for _ancli_bind in /sdcard /storage /mnt /data /apex /linkerconfig /system; do
    if [ -e "$_ancli_bind" ] || [ -d "$_ancli_bind" ]; then
        ANCLI_BIND_ARGS="$ANCLI_BIND_ARGS -b $_ancli_bind"
    fi
done
exec /data/local/tmp/ancli/bin/proot -r /data/local/tmp/ancli/rootfs -b /dev -b /proc -b /sys -b /data/local/tmp/ancli $ANCLI_BIND_ARGS -b /data/local/tmp/ancli/hosts:/etc/hosts -b /data/adb $SHM_BIND -w "$PROOT_CWD" /usr/bin/env python3 /data/local/tmp/ancli/bin/ancli-core.py "$@"
