{
  "version": "1.2.3",
  "apps": {
    "aider": {
      "name": "Aider",
      "description": "AI pair programming in your terminal",
      "author": "Paul Gauthier",
      "install_mode": "proot",
      "install_cmd": "pip install --break-system-packages aider-chat",
      "update_cmd": "pip install --upgrade --break-system-packages aider-chat",
      "uninstall_cmd": "pip uninstall -y aider-chat",
      "executable": "aider",
      "optional_env_vars": ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"],
      "version_cmd": "aider --version",
      "latest": { "source": "pypi", "package": "aider-chat" },
      "version": "0.86.2"
    },
    "mimo": {
      "name": "MiMo Code",
      "description": "Terminal AI agent tailored for Android/Proot",
      "author": "XiaomiMiMo",
      "install_mode": "proot",
      "install_cmd": "curl -L https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-arm64.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm /tmp/mimo.tar.gz",
      "update_cmd": "curl -L https://github.com/XiaomiMiMo/MiMo-Code/releases/latest/download/mimocode-linux-arm64.tar.gz -o /tmp/mimo.tar.gz && tar -xzf /tmp/mimo.tar.gz -C /usr/local/bin && rm /tmp/mimo.tar.gz",
      "uninstall_cmd": "rm -f /usr/local/bin/mimo",
      "executable": "mimo",
      "optional_env_vars": ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"],
      "version_cmd": "mimo --version",
      "latest": { "source": "github", "repo": "XiaomiMiMo/MiMo-Code" },
      "version": "0.1.14"
    },
    "agy": {
      "name": "Antigravity CLI",
      "description": "Google's powerful terminal agent",
      "author": "Google",
      "install_mode": "proot",
      "install_method": "pipe_script",
      "installer_url": "https://antigravity.google/cli/install.sh",
      "installer_args": "--dir /usr/local/bin",
      "installer_script_env": {},
      "install_cmd": "curl -sL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin",
      "update_cmd": "agy update",
      "uninstall_cmd": "rm -f /usr/local/bin/agy /root/.local/bin/agy",
      "executable": "agy",
      "optional_env_vars": ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"],
      "version_cmd": "agy --version",
      "latest": {
        "source": "json",
        "url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_arm64.json",
        "path": "version",
        "note": "Official Antigravity release manifest (same endpoint the vendor installer reads)."
      },
      "version": "1.2.12"
    },
    "claude-code": {
      "name": "Claude Code",
      "description": "Anthropic's official terminal coding agent",
      "author": "Anthropic",
      "install_mode": "proot",
      "install_cmd": "curl -L https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-arm64.tar.gz -o /tmp/claude.tar.gz && tar -xzf /tmp/claude.tar.gz -C /usr/local/bin && rm /tmp/claude.tar.gz",
      "update_cmd": "curl -L https://github.com/anthropics/claude-code/releases/latest/download/claude-linux-arm64.tar.gz -o /tmp/claude.tar.gz && tar -xzf /tmp/claude.tar.gz -C /usr/local/bin && rm /tmp/claude.tar.gz",
      "uninstall_cmd": "rm -f /usr/local/bin/claude",
      "env_vars": [],
      "optional_env_vars": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL",
        "ANTHROPIC_MODEL",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY"
      ],
      "executable": "claude",
      "version_cmd": "claude --version",
      "latest": { "source": "github", "repo": "anthropics/claude-code" },
      "version": "2.1.283"
    },
    "opencode": {
      "name": "OpenCode",
      "description": "Open-source terminal-based AI coding agent",
      "author": "Sst Labs",
      "install_mode": "proot",
      "install_cmd": "curl -L https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-arm64.tar.gz -o /tmp/opencode.tar.gz && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && rm /tmp/opencode.tar.gz",
      "update_cmd": "curl -L https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-arm64.tar.gz -o /tmp/opencode.tar.gz && tar -xzf /tmp/opencode.tar.gz -C /usr/local/bin && rm /tmp/opencode.tar.gz",
      "uninstall_cmd": "rm -f /usr/local/bin/opencode",
      "executable": "opencode",
      "optional_env_vars": ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"],
      "version_cmd": "opencode --version",
      "latest": { "source": "github", "repo": "anomalyco/opencode" },
      "version": "1.18.32"
    },
    "grok": {
      "name": "Grok CLI",
      "description": "xAI's official terminal coding agent",
      "author": "xAI",
      "install_mode": "proot",
      "install_method": "pipe_script",
      "installer_url": "https://x.ai/cli/install.sh",
      "installer_args": "",
      "installer_script_env": {
        "GROK_BIN_DIR": "/usr/local/bin"
      },
      "install_cmd": "curl -fsSL https://x.ai/cli/install.sh | bash",
      "update_cmd": "curl -fsSL https://x.ai/cli/install.sh | bash",
      "uninstall_cmd": "rm -f /usr/local/bin/grok /usr/local/bin/agent && rm -rf /root/.grok",
      "executable": "grok",
      "optional_env_vars": ["HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY"],
      "version_cmd": "grok --version",
      "latest": {
        "source": "text",
        "urls": [
          "https://x.ai/cli/stable",
          "https://storage.googleapis.com/grok-build-public-artifacts/cli/stable"
        ],
        "note": "Vendor channel pointer (x.ai/cli/<channel>) with the GCS mirror the installer falls back to."
      },
      "version": "1.0.41"
    }
  }
}
